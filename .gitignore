# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.production

# vercel
.vercel

# electron — track source + installers; skip deps/unpacked/oversized builds
/electron/node_modules/
/electron/dist/win-unpacked/
/dist-electron/node_modules/
/dist-electron/win-unpacked/
/dist-electron/*.exe
*.dll
*.pak
# allow portable Electron Setup installers under electron/dist (<100MB GitHub limit)
*.exe
!/electron/dist/*.exe
!/electron/dist/*.blockmap
/tmp-logs/
/kaystonehr-attendance-extension/
/kaystonehr-attendance-extension.zip

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
*firebase-adminsdk*.json

.vercel

.vercel

.vercel
