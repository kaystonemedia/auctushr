{
  "name": "auctushr",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup:supabase": "node setup-supabase.js",
    "setup:storage": "node setup-supabase.js",
    "electron": "electron .",
    "electron:web": "wait-on http://localhost:3000 && electron .",
    "electron:desktop-monitor": "electron . --monitoring-ui",
    "electron:standalone": "cd electron && npm start",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "cross-env BUILD_TARGET=electron npm run build && electron-builder",
    "electron:dist": "cross-env BUILD_TARGET=electron npm run build && electron-builder --publish=never"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@headlessui/react": "^2.2.0",
    "@hookform/resolvers": "^5.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@supabase/supabase-js": "^2.50.3",
    "@tanstack/react-table": "^8.21.2",
    "@types/js-cookie": "^3.0.6",
    "@types/nodemailer": "^7.0.3",
    "assert": "^2.1.0",
    "axios": "^1.10.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-store": "^8.1.0",
    "electron-window-state": "^5.0.3",
    "framer-motion": "^12.6.3",
    "js-cookie": "^3.0.5",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "libphonenumber-js": "^1.12.6",
    "lucide-react": "^0.487.0",
    "mongodb": "^6.15.0",
    "next": "15.2.6",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.10.1",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "^9.6.4",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.4",
    "react-hot-toast": "^2.5.2",
    "recharts": "^2.15.2",
    "resend": "^6.4.2",
    "screenshot-desktop": "^1.15.3",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.3",
    "eslint": "^9",
    "eslint-config-next": "15.2.6",
    "postcss": "^8.5.3",
    "supabase": "^2.30.4",
    "tailwindcss": "^3.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.auctushr.monitor",
    "productName": "Auctushr Monitor",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/",
      "out/",
      "node_modules/",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
