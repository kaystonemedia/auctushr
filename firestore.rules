rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let employeeDoc = get(/databases/$(database)/documents/employees/$(request.auth.uid));
      let managerDoc = get(/databases/$(database)/documents/managers/$(request.auth.uid));
      
      return userDoc != null && userDoc.data.role != null ? userDoc.data.role :
             (employeeDoc != null && employeeDoc.data.role != null ? employeeDoc.data.role :
             (managerDoc != null && managerDoc.data.role != null ? managerDoc.data.role : null));
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isManager() {
      return isAuthenticated() && getUserRole() == 'manager';
    }

    function isEmployee() {
      return isAuthenticated() && getUserRole() == 'employee';
    }

    function isManagerOf(employeeId) {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/employees/$(employeeId)).data.managerId == request.auth.uid);
    }

    function isOwnerOfEmployeeRecord(employeeId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/employees/$(employeeId)) &&
        get(/databases/$(database)/documents/employees/$(employeeId)).data.uid == request.auth.uid;
    }

    function hasOnlyRoleMirrorFields() {
      return request.resource.data.diff(null).affectedKeys()
        .hasOnly(['uid', 'email', 'role', 'linkedRecordId', 'hasPassword', 'updatedAt']);
    }

    function canCreateSelfAdminMirror() {
      return isAuthenticated() &&
        request.resource.id == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'admin' &&
        request.resource.data.linkedRecordId is string &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.linkedRecordId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.linkedRecordId)).data.uid == request.auth.uid &&
        hasOnlyRoleMirrorFields();
    }

    function canCreateSelfManagerMirror() {
      return isAuthenticated() &&
        request.resource.id == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'manager' &&
        request.resource.data.linkedRecordId is string &&
        exists(/databases/$(database)/documents/managers/$(request.resource.data.linkedRecordId)) &&
        get(/databases/$(database)/documents/managers/$(request.resource.data.linkedRecordId)).data.uid == request.auth.uid &&
        hasOnlyRoleMirrorFields();
    }

    function canCreateSelfEmployeeMirror() {
      return isAuthenticated() &&
        request.resource.id == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'employee' &&
        request.resource.data.linkedRecordId is string &&
        exists(/databases/$(database)/documents/employees/$(request.resource.data.linkedRecordId)) &&
        get(/databases/$(database)/documents/employees/$(request.resource.data.linkedRecordId)).data.uid == request.auth.uid &&
        hasOnlyRoleMirrorFields();
    }

    // Helper for first-time login updates
    function isFirstTimeLoginUpdate() {
      return isAuthenticated() &&
             resource.data.hasPassword == false &&
             resource.data.uid == null &&
             request.resource.data.email == resource.data.email &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['hasPassword', 'uid', 'updatedAt']) &&
             request.resource.data.hasPassword == true &&
             request.resource.data.uid == request.auth.uid &&
             request.resource.data.uid.size() > 0;
    }

    // Users collection rules
    match /users/{userId} {
      // Allow email queries for login (more permissive)
      allow list: if !isAuthenticated() && request.query.limit <= 1;
      
      // Allow document reads for login
      allow get: if !isAuthenticated();
      
      // Allow first-time login updates and authenticated updates
      allow update: if isFirstTimeLoginUpdate() || 
                   (isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid));
      
      // Allow admins or the user themselves (for mirror docs) to create
      allow create: if (isAuthenticated() && isAdmin()) || canCreateSelfAdminMirror();
      
      // Allow authenticated users to read based on role
      allow read: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
      
      // Only admins can delete users
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Employees collection rules
    match /employees/{employeeId} {
      // Allow email queries for login (more permissive) and allow admins/managers to run queries
      allow list: if (!isAuthenticated() && request.query.limit <= 1) ||
                  (isAuthenticated() && (isAdmin() || isManager()));
      
      // Allow document reads for login
      allow get: if !isAuthenticated();
      
      // Allow first-time login updates and authenticated updates
      allow update: if isFirstTimeLoginUpdate() || 
                   (isAuthenticated() && (
                     isAdmin() ||
                     (isManagerOf(employeeId)) ||
                     (resource.data.uid == request.auth.uid)
                   ));
      
      // Allow any authenticated user to create employee records
      // (application-level logic restricts this to admins/managers)
      allow create: if isAuthenticated() || canCreateSelfEmployeeMirror();
      
      // Allow authenticated users to read based on role
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        resource.data.uid == request.auth.uid || 
        isManagerOf(employeeId)
      );
      
      // Only admins can delete employees
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Managers collection rules
    match /managers/{managerId} {
      // Allow email queries for login (more permissive)
      allow list: if !isAuthenticated() && request.query.limit <= 1;
      
      // Allow document reads for login
      allow get: if !isAuthenticated();
      
      // Allow first-time login updates and authenticated updates
      allow update: if isFirstTimeLoginUpdate() || 
                   (isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid));
      
      // Allow admins or the manager themselves (for mirror docs) to create
      allow create: if (isAuthenticated() && isAdmin()) || canCreateSelfManagerMirror();
      
      // Allow authenticated users to read their own document
      allow read: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
      
      // Only admins can delete managers
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Attendance collection rules
    match /attendance/{recordId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        resource.data.employeeId == request.auth.uid ||
        (isManager() && resource.data.managerId == request.auth.uid)
      );

      // Allow any authenticated user to create their own attendance record
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isManager() ||
        request.resource.data.employeeId == request.auth.uid
      );

      // Allow updates by admins, managers, or the employee who owns the record
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isManager() && (
          request.resource.data.employeeId == resource.data.employeeId ||
          request.resource.data.managerId == request.auth.uid
        )) ||
        resource.data.employeeId == request.auth.uid
      );

      allow delete: if isAuthenticated() && isAdmin();
    }

    // Tasks collection rules - Simplified for internal HR system
    match /tasks/{taskId} {
      // All authenticated users can read tasks
      allow read: if isAuthenticated();

      // Admins and managers can create tasks
      allow create: if isAuthenticated() && (isAdmin() || isManager());

      // All authenticated users can update tasks (employees can update their assigned tasks)
      allow update: if isAuthenticated();

      // Admins and managers can delete tasks
      allow delete: if isAuthenticated() && (isAdmin() || isManager());
    }

    // Notifications collection rules
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.employeeId == request.auth.uid ||
        isOwnerOfEmployeeRecord(resource.data.employeeId)
      );
      // Any authenticated context (app or extension) can create notifications
      allow create: if isAuthenticated();
      // Any authenticated user can mark notifications as read/updated
      // (Notifications are already filtered per user at the application level)
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Settings collection rules
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // Focus Sessions collection rules (for productivity tracking)
    match /focusSessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        resource.data.employeeId == request.auth.uid
      );

      allow create: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        (isEmployee() && request.resource.data.employeeId == request.auth.uid)
      );

      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isEmployee() && resource.data.employeeId == request.auth.uid)
      );

      allow delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.employeeId == request.auth.uid
      );
    }

    // Time Tracking collection rules
    match /timeTracking/{trackingId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        resource.data.employeeId == request.auth.uid
      );

      allow create: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        (isEmployee() && request.resource.data.employeeId == request.auth.uid)
      );

      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isEmployee() && resource.data.employeeId == request.auth.uid)
      );

      allow delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.employeeId == request.auth.uid
      );
    }

    // Break Sessions collection rules
    match /breakSessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        resource.data.employeeId == request.auth.uid
      );

      allow create: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        (isEmployee() && request.resource.data.employeeId == request.auth.uid)
      );

      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isEmployee() && resource.data.employeeId == request.auth.uid)
      );

      allow delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.employeeId == request.auth.uid
      );
    }

    // Leave Requests collection rules
    match /leaveRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        resource.data.employeeId == request.auth.uid ||
        (isManager() && resource.data.managerId == request.auth.uid)
      );

      // Allow any authenticated user to create a leave request.
      // Application logic constrains who can see/act on which requests.
      allow create: if isAuthenticated();

      allow update: if isAuthenticated() && (
        isAdmin() || 
        // Managers can only act on requests for their team members, and never their own
        (isManager() && resource.data.managerId == request.auth.uid && resource.data.employeeId != request.auth.uid) ||
        (isEmployee() && resource.data.employeeId == request.auth.uid)
      );

      allow delete: if isAuthenticated() && isAdmin();
    }

    // Payroll collection rules
    match /payroll/{payrollId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.employeeId == request.auth.uid
      );

      allow create: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Reports collection rules
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isManager()
      );

      allow create: if isAuthenticated() && (
        isAdmin() || 
        isManager()
      );

      allow update: if isAuthenticated() && (
        isAdmin() || 
        isManager()
      );

      allow delete: if isAuthenticated() && isAdmin();
    }

    // Departments collection rules
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Default rule for other collections (more permissive for authenticated users)
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
  }
} 