{
  "manifest_version": 3,
  "name": "KaystoneHR Attendance",
  "version": "1.0.0",
  "description": "Track attendance and productivity for KaystoneHR employees",
  "permissions": [
    "storage",
    "idle",
    "tabs",
    "geolocation",
    "scripting",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://kaystonehr.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kaystonehr.com/*",
        "https://*.google.com/*",
        "https://*.microsoft.com/*",
        "https://*.office.com/*",
        "https://*.slack.com/*",
        "https://*.zoom.us/*",
        "https://*.teams.microsoft.com/*"
      ],
      "js": ["consent-manager.js", "content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["content-script.js"],
    "matches": ["<all_urls>"]
  }],
  "optional_permissions": [
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
} 