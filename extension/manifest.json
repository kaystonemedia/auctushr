{
  "manifest_version": 3,
  "name": "Auctushr Attendance",
  "version": "1.0.0",
  "description": "Track attendance and productivity for Auctushr employees",
  "permissions": [
    "storage",
    "idle",
    "tabs",
    "geolocation",
    "scripting",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://auctushr.com/*",
    "https://auctushr.vercel.app/*",
    "http://localhost:3000/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["content-script.js"],
    "matches": ["<all_urls>"]
  }]
} 